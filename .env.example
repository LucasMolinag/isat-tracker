# App URL (Auth.js / redirects)
AUTH_URL=http://localhost:3000
# Or legacy alias:
# NEXTAUTH_URL=http://localhost:3000

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Web application client)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Aliases also accepted by src/auth.ts:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Postgres (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/isat_tracker?sslmode=require

# AES-256 key for encrypting OAuth tokens at rest (32 bytes as hex or base64)
# Generate hex: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
