# ─── App URL (Auth.js redirects) ───────────────────────────────────────────
# Local:
AUTH_URL=http://localhost:3000
# Production (Vercel):
# AUTH_URL=https://YOUR_PROJECT.vercel.app
# Legacy alias also accepted: NEXTAUTH_URL=

# Auth.js session secret — openssl rand -base64 32
AUTH_SECRET=

# ─── Google OAuth (Web application client) ─────────────────────────────────
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Aliases also accepted by src/auth.ts / google-auth.ts:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Authorized redirect URIs in GCP OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_PROJECT.vercel.app/api/auth/callback/google
#
# Required scopes (consent screen + client):
#   openid email profile
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/spreadsheets.readonly
#   https://www.googleapis.com/auth/forms.responses.readonly

# ─── Postgres (Prisma) ─────────────────────────────────────────────────────
# Neon / Supabase / any Postgres. Prefer pooled URL for serverless.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/isat_tracker?sslmode=require

# ─── Token encryption at rest (AES-256) ────────────────────────────────────
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ─── Scheduled sync (Vercel Cron → GET /api/cron/sync) ─────────────────────
# openssl rand -base64 32
# Vercel sends: Authorization: Bearer $CRON_SECRET
# Manual: curl -H "Authorization: Bearer $CRON_SECRET" https://YOUR_HOST/api/cron/sync
# Or:     curl "https://YOUR_HOST/api/cron/sync?secret=$CRON_SECRET"
CRON_SECRET=
